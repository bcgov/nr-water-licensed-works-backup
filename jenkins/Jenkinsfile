// Water Licensed Works - hourly notification job.
//
// Reads the status objects that the GitHub Actions backup and check jobs write
// to object storage, and sends alert mail through an internal SMTP relay. It
// runs here rather than in Actions for one reason: a GitHub-hosted runner
// cannot reach that relay, and this host can. Everything else about the
// pipeline stays in Actions.
//
// What it touches:
//
//   reads   the status/ prefix in object storage
//   writes  one object, its own deduplication state, under notify/
//   sends   mail through the relay
//
// It deletes and copies nothing, holds no ArcGIS Online credentials, touches
// no feature layer, and has no restore path of any kind. The storage
// credential it holds is not scoped to those prefixes - it cannot be - so that
// narrow behaviour is a convention held in notify.py and asserted by
// tests/test_notify.py rather than a permission boundary.

pipeline {
    // No agent label, and that is deliberate rather than unconsidered: a poll
    // needs no particular capability - no arcpy, no geodatabase, no large
    // workspace - only network reach and the interpreter named below.
    //
    // The consequence worth remembering: THIS JOB CAN RUN ON A DIFFERENT
    // MACHINE EVERY HOUR. Nothing it needs between polls may live on an
    // agent's disk, which is why its deduplication state is kept in object
    // storage. A state file would be silently wrong the first time the
    // scheduler picked a different machine, and the symptom would be an email
    // every hour - the one failure this job is written to avoid.
    agent any

    options {
        // Hourly polling fills a build list quickly. Fifty builds is a little
        // over two days, which is enough to see what happened around an alert
        // without keeping a month of "nothing to do".
        buildDiscarder(logRotator(numToKeepStr: '50'))
        // A poll takes seconds. Anything past this is an unreachable relay or
        // a hung connection, and it must not still be running when the next
        // hour's build starts.
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    triggers {
        // Hourly, at a stable but arbitrary minute rather than on the hour.
        // 'H' spreads the load instead of joining every other hourly job at
        // the top of the hour.
        //
        // HOURLY POLLING DOES NOT MEAN HOURLY EMAIL. The check job writes one
        // status object a day, and notify.py mails only when the situation
        // changes, so a failure lasting five days produces two messages - one
        // alert, one resolution - whatever the poll frequency. What the
        // frequency buys is latency.
        //
        // It is also what makes the grace periods in config.yml enforceable.
        // schedule.checks_grace_hours is 2, and a job that looked once a day
        // could not detect a two-hour delay at all. Polling every two hours is
        // the floor; anything slower means raising those grace periods to
        // match and accepting later detection. Change the two together or not
        // at all.
        cron('H * * * *')
    }

    parameters {
        // Tick this on a manual "Build with Parameters" run to have the job
        // report what it would send and send nothing. Scheduled builds use the
        // default and send for real.
        //
        // A parameter rather than a stored setting, because it is for reading
        // a message before it goes out rather than for holding the job back.
        // What makes a testing period safe is pointing the ALERT_* credentials
        // at a test address, so that a real send reaches one person.
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Report what would be sent and send nothing. Writes no state, so it cannot suppress a later real alert.'
        )
    }

    environment {
        // The deduplication state - what this job last sent mail about, and
        // the thing that turns an hourly poll into occasional email - needs no
        // setting here. It lives in object storage under the project's own
        // notify/ prefix, so this job needs no writable directory anywhere and
        // nothing that has to survive a workspace wipe, and it keeps working
        // when the job lands on a different agent from one hour to the next.
        NOTIFY_ARGS = "${params.DRY_RUN ? '--dry-run' : ''}"

        // EVERY SETTING BELOW COMES FROM THE JENKINS CREDENTIAL STORE.
        //
        // Some are secrets and some are not. What they have in common is that
        // they are properties of the machine this runs on rather than of the
        // project - an interpreter path, a mail relay, one address per
        // notification role - and that none of them belongs in this
        // repository, which is public. Internal paths and staff addresses stay
        // out of it.
        //
        // One consequence to expect: Jenkins masks anything from the
        // credential store, so a recipient list prints as **** in the build
        // log, including in the dry-run report. Read the 'roles' line instead.
        // It names data_owner, shared_inbox and developer in clear, which is
        // what tells you the routing is right; the addresses themselves are
        // checked in the credential store.
        //
        // Bound with credentials() here rather than in a withCredentials block
        // so that they reach the post { failure } handler as well as the
        // stages. That handler is the only thing that reports this job failing.
        //
        // With one gap worth knowing rather than being surprised by: this
        // block is evaluated after the implicit checkout, so a build that dies
        // during the checkout has nothing bound and cannot mail anybody. The
        // post handler says so in the log instead of throwing a second
        // exception over the first, but the limit stands - a failure that
        // early is visible as a red build and nothing more.

        // The interpreter. Called by full path rather than by activating a
        // conda environment, which is safe here precisely because everything
        // notify.py imports is pure Python and needs no activation. It would
        // NOT be safe for anything importing arcpy, which needs its
        // environment activated for the DLL search path. Nothing here does.
        PYTHON = credentials('wlw-notify-python')

        // The same object storage key pair the GitHub Actions jobs hold. It is
        // not scoped and cannot be, so "this job only reads status objects and
        // writes one state object" is held in notify.py and asserted by
        // tests/test_notify.py rather than by a permission.
        S3_NRS_ENDPOINT = credentials('wlw-s3-endpoint')
        S3_GSS_GEODRIVE_KEY_ID = credentials('wlw-s3-key-id')
        S3_GSS_GEODRIVE_SECRET_KEY = credentials('wlw-s3-secret-key')

        // The relay, which is reachable from this host and from no GitHub
        // runner - the whole reason this job exists outside Actions.
        SMTP_HOST = credentials('wlw-smtp-host')
        SMTP_SENDER = credentials('wlw-smtp-sender')

        // One per recipient role. config.yml maps each role to the NAME of its
        // variable and never to an address, so pointing all three at a single
        // test inbox for the first few days is a change here and nowhere else.
        ALERT_DATA_OWNER = credentials('wlw-alert-data-owner')
        ALERT_SHARED_INBOX = credentials('wlw-alert-shared-inbox')
        ALERT_DEVELOPER = credentials('wlw-alert-developer')
    }

    // THIS PIPELINE NEVER CHECKS THE REPOSITORY OUT, and that is the point of
    // the fetch stage below.
    //
    // The agents that run this job cannot reach github.com. They can reach
    // object storage. So the bucket carries the code to them: a GitHub Actions
    // workflow publishes notify.py and config.yml under the code/ prefix on
    // every push to main, and the first stage here downloads them.
    //
    // Which means this file is pasted into the Jenkins job as an inline
    // pipeline script rather than read from source control. The copy in the
    // repository is the canonical one - edit there, review there, then paste.
    // A change made only in the job configuration is a change nobody can see.
    //
    // What the agent needs from its machine is now just two things: reach to
    // the object storage endpoint, and reach to the mail relay.
    stages {
        // The environment check runs FIRST, before the fetch. The fetch itself
        // needs boto3, so an interpreter missing it would fail there with a
        // traceback about downloading rather than with the sentence below.
        stage('Check the environment') {
            steps {
                // This CHECKS the interpreter and never installs into it.
                //
                // The interpreter may be a managed environment shared with
                // other work and not this project's to modify. Installing into
                // one from a scheduled job would be an unreviewed change to
                // somebody else's Python, repeated every hour. So the packages
                // are a prerequisite, listed in jenkins/requirements.txt, and
                // this stage exists to fail loudly at the top of the build if
                // they ever stop being available. The alternative is an
                // ImportError two stages later that reads like a code fault.
                //
                // If something is missing and cannot be added to that
                // environment, the way round it leaves the environment alone
                // too: pip install --target into a directory this account
                // owns, and put that directory in PYTHONPATH. It would need a
                // binding of its own above, which is a two-line change.
                //
                // ZoneInfo is constructed rather than merely imported, because
                // that is what actually proves the timezone database is
                // reachable - Windows ships none of its own - and every
                // staleness decision notify.py makes is timezone conversion.
                //
                // bat because this host is Windows. On a Linux agent every bat
                // step becomes sh, and the timezone database is already there.
                bat '''"%PYTHON%" -c "import boto3, yaml, zoneinfo; zoneinfo.ZoneInfo('America/Vancouver'); print('boto3, PyYAML and tzdata are all present')" || (echo. & echo The Python named by the wlw-notify-python credential cannot import something notify.py needs - jenkins/requirements.txt lists the three and says why. & echo Do not install into that environment if it is shared or managed. & echo Instead, pip install --target into a directory this account owns and set PYTHONPATH to it. & exit /b 1)'''
            }
        }

        stage('Fetch the code') {
            steps {
                // The bucket and prefix are written out here rather than read
                // from config.yml, because this is the step that fetches
                // config.yml. Both are already in the repository in plain
                // sight; neither is any use without the endpoint and keys,
                // which are credentials.
                //
                // The files land in the layout notify.py expects - itself in
                // jenkins/, config.yml beside it at the top - so the poll stage
                // runs exactly the command it would have run after a checkout.
                //
                // The manifest is read for two reasons: it names the commit the
                // code came from, which the build log should say, and it
                // carries a SHA-256 of each file. A truncated notify.py would
                // fail on import and be obvious, but a truncated config.yml can
                // still parse as valid YAML with whole sections missing, which
                // would leave this job routing alerts by an incomplete table.
                writeFile file: 'fetch_code.py', text: '''
"""Download the notification job's code from object storage.

Published by publish_notify_code.py in GitHub Actions on every push to main.
This runs before anything else in the build, so it uses boto3 and the standard
library only - nothing from the repository is on disk yet.
"""

import hashlib
import json
import os
import pathlib
import sys

import boto3

BUCKET = "gssgeodrive"
CODE_PREFIX = "authorizations/backups/water_licensed_works/code/"

# Published name -> where it goes in the workspace. The other half of this
# mapping is PUBLISHED_FILES in publish_notify_code.py, and tests/test_notify.py
# asserts the two still agree.
WANTED = {"notify.py": "jenkins/notify.py", "config.yml": "config.yml"}


def main():
    client = boto3.client(
        "s3",
        endpoint_url=os.environ["S3_NRS_ENDPOINT"],
        aws_access_key_id=os.environ["S3_GSS_GEODRIVE_KEY_ID"],
        aws_secret_access_key=os.environ["S3_GSS_GEODRIVE_SECRET_KEY"],
    )

    manifest = json.loads(
        client.get_object(Bucket=BUCKET, Key=CODE_PREFIX + "manifest.json")["Body"].read()
    )

    for published, destination in sorted(WANTED.items()):
        path = pathlib.Path(destination)
        path.parent.mkdir(parents=True, exist_ok=True)
        client.download_file(BUCKET, CODE_PREFIX + published, str(path))

        expected = manifest["files"][published]
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
        if actual != expected:
            print(
                f"{published} does not match the checksum in the manifest, so "
                f"the download is incomplete or the two were published out of "
                f"step. Re-run the 'Publish notify code' workflow in GitHub "
                f"Actions and build again."
            )
            return 1
        print(f"fetched {published} to {destination}")

    print(f"code version {manifest['code_version']}, published {manifest['published_utc']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
'''
                bat '"%PYTHON%" fetch_code.py'
            }
        }

        stage('Poll and notify') {
            steps {
                // Everything this needs is already bound in the environment
                // above.
                //
                // No shell tracing anywhere in this file. A build log is
                // readable by anyone with access to this Jenkins, and an
                // echoed command line would put the object storage key in it.
                // Jenkins masks a credential on an exact string match only, so
                // it will not catch one that has been re-encoded on the way
                // into a traceback.
                bat '"%PYTHON%" jenkins/notify.py %NOTIFY_ARGS%'
            }
        }
    }

    post {
        failure {
            // The one failure nothing else covers: this job itself. Every
            // other problem in the pipeline is detected by something
            // downstream of it, and a notifier that has stopped is detected by
            // nothing - so it goes to the developer, who is the only person
            // able to act on it.
            //
            // The core `mail` step rather than emailext, so this needs no
            // plugin beyond what a stock Jenkins has. It uses Jenkins' own
            // SMTP configuration rather than SMTP_HOST, deliberately: the two
            // are configured separately, and this one has to keep working on a
            // build where notify.py never got far enough to read a setting.
            // If these never arrive, that Jenkins-level mail configuration is
            // the thing to check.
            //
            // Guarded, because a build that fails during the implicit checkout
            // never reached the environment block and has no address to send
            // to. Calling mail with an empty recipient throws, which buries
            // the real failure under a second stack trace - the opposite of
            // what a failure handler is for.
            script {
                if (env.ALERT_DEVELOPER) {
                    mail(
                        to: "${env.ALERT_DEVELOPER}",
                        subject: "[Water Licensed Works] The notification job failed - build ${env.BUILD_NUMBER}",
                        body: """The hourly notification job failed.

While it is failing, no alert from the backup or check jobs is being
delivered. Those jobs are unaffected and are still running in GitHub
Actions, and their results are still being written to object storage, so
nothing is lost - the alerts are delayed rather than missed, and will be
sent once this is fixed.

Build: ${env.BUILD_URL}
"""
                    )
                } else {
                    echo(
                        'This build failed before the credentials were bound, ' +
                        'so there is no address to send a failure notice to. ' +
                        'The usual cause is the checkout: the agent has to be ' +
                        'able to reach github.com. See the error above.'
                    )
                }
            }
        }
    }
}
